<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:label="Télécommande"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Remote2Activity"
            android:exported="false"
            android:label="Télécommande Zen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PictureSettingsActivity"
            android:exported="false"
            android:label="Réglages image"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MoreActivity"
            android:exported="false"
            android:label="Plus de commandes"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SourceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Source"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Widget 1 : modes d'économie d'énergie -->
        <receiver
            android:name=".EcoWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Modes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eco_widget_info" />
        </receiver>

        <!-- Widget : modes éco + lecture / pause -->
        <receiver
            android:name=".EcoPlayWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Éco et lecture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eco_play_widget_info" />
        </receiver>

        <!-- Widget 2 : marche / arrêt -->
        <receiver
            android:name=".PowerWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Marche/Arrêt">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/power_widget_info" />
        </receiver>

        <!-- Widget 3 : source -->
        <receiver
            android:name=".SourceWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Source">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/source_widget_info" />
        </receiver>

        <!-- Widget 4 : mini-télécommande volume / chaînes -->
        <receiver
            android:name=".MiniRemoteWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Volume et chaînes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_widget_info" />
        </receiver>

        <!-- Widget 5 : télécommande complète -->
        <receiver
            android:name=".RemoteWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Télécommande">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_info" />
        </receiver>

        <!-- Widget 6 : scènes -->
        <receiver
            android:name=".SceneWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Scènes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scene_widget_info" />
        </receiver>

        <!-- Widget 7 : chaînes favorites du décodeur -->
        <receiver
            android:name=".ChannelWidgetProvider"
            android:exported="true"
            android:label="Éco TV · Chaînes favorites">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/channel_widget_info" />
        </receiver>

        <!-- Widgets design -->
        <receiver
            android:name=".ImageDesignWidget"
            android:exported="true"
            android:label="Éco TV · Image (design)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dw_image_info" />
        </receiver>

        <receiver
            android:name=".SleepDesignWidget"
            android:exported="true"
            android:label="Éco TV · Veille (design)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dw_sleep_info" />
        </receiver>

        <receiver
            android:name=".PadDesignWidget"
            android:exported="true"
            android:label="Éco TV · Croix (design)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dw_pad_info" />
        </receiver>

        <receiver
            android:name=".MediaDesignWidget"
            android:exported="true"
            android:label="Éco TV · Lecture (design)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dw_media_info" />
        </receiver>

        <receiver
            android:name=".NumpadDesignWidget"
            android:exported="true"
            android:label="Éco TV · Chiffres (design)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dw_numpad_info" />
        </receiver>

        <!-- Minuterie de veille -->
        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <!-- Pause automatique de la TV pendant un appel -->
        <service
            android:name=".CallPauseService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Met la lecture de la TV en pause pendant un appel et la reprend ensuite" />
        </service>

        <!-- Décodeur gardé éveillé tant que la TV est allumée -->
        <service
            android:name=".KeepAwakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Envoie une touche sans effet au décodeur tant que la TV est allumée, pour éviter sa mise en veille" />
        </service>

        <!-- Tuiles des Réglages rapides -->
        <service
            android:name=".PowerTileService"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="@string/tile_power"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".MuteTileService"
            android:exported="true"
            android:icon="@drawable/ic_mute"
            android:label="@string/tile_mute"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
