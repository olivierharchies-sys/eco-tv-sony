<?xml version="1.0" encoding="utf-8"?>
<!-- Pilule « Télécommande » des en-têtes de widget : dégradé violet → bleu. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF8B5CF6" android:endColor="#FF3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
