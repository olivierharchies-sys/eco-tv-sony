<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton rond du mode actif : dégradé menthe → cyan avec halo. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#2634D399" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#FF34D399" android:endColor="#FF06B6D4" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
