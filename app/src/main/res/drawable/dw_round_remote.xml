<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton rond « télécommande » : dégradé violet → bleu. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#FF8B5CF6" android:endColor="#FF3B82F6" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
