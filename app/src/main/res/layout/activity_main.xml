<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1014"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/app_subtitle"
            android:textColor="#FF9AA0A6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_open_remote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_primary"
            android:text="@string/open_remote"
            android:textAllCaps="false"
            android:textColor="#FF0E1014"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connection_title"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/field_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_ip"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF9AA0A6" />

            <EditText
                android:id="@+id/field_psk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_psk"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF9AA0A6" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_surface"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_title"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_off"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_surface"
                    android:text="@string/mode_off"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/test_low"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_surface"
                    android:text="@string/mode_low"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_high"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_surface"
                    android:text="@string/mode_high"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/test_picture_off"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_surface"
                    android:text="@string/mode_picture_off"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_read"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_surface"
                android:text="@string/read_mode"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FF34C77B"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/help"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
