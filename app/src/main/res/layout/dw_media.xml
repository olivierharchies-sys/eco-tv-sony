<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_play"
            android:tint="#FF93C5FD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:singleLine="true"
            android:text="@string/dw_media_title"
            android:textColor="#FF93C5FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dw_media_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:singleLine="true"
            android:text="@string/dw_target_decoder"
            android:textColor="#FF8B93A7"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@string/dw_cd_prev"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_rew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@string/dw_cd_rewind"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rewind"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/dw_round_remote"
                android:contentDescription="@string/dw_cd_play"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@string/dw_cd_pause"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_fwd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@string/dw_cd_forward"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/dw_media_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@string/dw_cd_next"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
