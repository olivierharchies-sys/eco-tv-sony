<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_eco"
            android:tint="#FF5EEAD4" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:singleLine="true"
            android:text="@string/widget_title_default"
            android:textColor="#FF5EEAD4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_remote"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/dw_pill_remote"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/widget_remote"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btn_off"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_brightness"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text="@string/mode_off"
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btn_low"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dw_round_on"
                android:contentDescription="@null"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eco"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text="@string/mode_low"
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btn_high"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eco"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text="@string/mode_high"
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btn_picture_off"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tv"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text="@string/mode_picture_off"
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
