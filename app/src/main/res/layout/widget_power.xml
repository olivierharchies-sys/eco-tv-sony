<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/power_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tile_off"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/widget_power_label"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_power" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_power_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/power_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_power_unknown"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
