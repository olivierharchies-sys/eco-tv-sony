<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_power"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_on"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_power"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_source"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_input"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_web"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_language"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_more"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apps"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_dev_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_devices_home"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_tv_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_options"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_up"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_up"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_left"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rc_ok"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dw_round_remote"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="OK"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_right"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_down"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_down"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_vol_down"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_vol_down"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_mute"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mute"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/rc_vol_up"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_vol_up"
                android:tint="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rc_ch_down"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="CH −"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rc_ch_up"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="CH +"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
