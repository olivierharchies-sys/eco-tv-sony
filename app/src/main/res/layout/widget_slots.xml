<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/slots_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:singleLine="true"
        android:text="@string/widget_title_default"
        android:textColor="#FFF9A8D4"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/slot_1_badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dw_round_remote"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="•"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/slot_1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/slot_2_badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="•"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/slot_2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/slot_3_badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="•"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/slot_3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/slot_4_badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dw_round_idle"
                android:contentDescription="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:text="•"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/slot_4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="72dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFB4BCCB"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_5"
            android:layout_width="0dp"
