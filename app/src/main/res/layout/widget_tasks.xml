<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Suivi des tâches"
            android:textColor="#ECEFF4"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tw_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="Effacer"
            android:textColor="#34C77B"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tw_t1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ECEFF4"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/tw_p1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#34C77B" />
        <TextView
            android:id="@+id/tw_d1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tw_t2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ECEFF4"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/tw_p2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#34C77B" />
        <TextView
            android:id="@+id/tw_d2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tw_t3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ECEFF4"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/tw_p3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#34C77B" />
        <TextView
            android:id="@+id/tw_d3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tw_t4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ECEFF4"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/tw_p4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#34C77B" />
        <TextView
            android:id="@+id/tw_d4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
